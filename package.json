{
  "name": "drawcast",
  "version": "0.2.0",
  "description": "Turn a narrated Excalidraw script into a video. Local text-to-speech, no screen recording.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaojude/drawcast.git"
  },
  "type": "module",
  "bin": {
    "drawcast": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "examples",
    "!examples/*.mp4"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "excalidraw",
    "video",
    "whiteboard",
    "text-to-speech",
    "explainer",
    "agent-skill"
  ],
  "dependencies": {
    "@puppeteer/browsers": "^3.2.7",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.18.1",
    "sherpa-onnx-node": "^2.0.3"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
