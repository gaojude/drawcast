        {"at":0,"enter":"none","duration":0,"add":{"id":"key3","type":"text","x":64,"y":40,"text":"PR #23   /   BUDGET REPLAY","fontSize":24,"fontFamily":"code","strokeColor":"#076D65"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"head3","type":"text","x":62,"y":84,"text":"Start each slice where the last one ends","fontSize":55,"fontFamily":"normal","strokeColor":"#1D3539"}},
