        {"at":0,"enter":"none","duration":0,"add":{"id":"head2","type":"text","x":62,"y":84,"text":"Draw a wedge from its share","fontSize":55,"fontFamily":"normal","strokeColor":"#1D3539"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"rule2","type":"line","points":[[64,169],[1214,169]],"strokeColor":"#B7C9C5","strokeWidth":2,"roughness":0}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"old22","type":"text","x":632,"y":215,"text":"First budget script","fontSize":28,"fontFamily":"normal","strokeColor":"#526B6C"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"pairs22","type":"text","x":630,"y":263,"text":"126 coordinate pairs","fontSize":46,"fontFamily":"normal","strokeColor":"#1D3539"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"new22","type":"text","x":632,"y":400,"text":"With native slices","fontSize":28,"fontFamily":"normal","strokeColor":"#526B6C"}},
