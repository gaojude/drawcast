        {"at":0,"enter":"none","duration":0,"add":{"id":"coverTitle","type":"text","x":62,"y":110,"text":"How author trials changed Drawcast","fontSize":60,"fontFamily":"normal","strokeColor":"#1D3539"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"coverRule","type":"line","points":[[64,212],[1214,212]],"strokeColor":"#B7C9C5","strokeWidth":2,"roughness":0}},
        {"at":"A wave","enter":"draw","duration":0.6,"add":{"id":"coverWave","type":"line","x":85,"y":292,"width":294,"height":190,"domain":[0,12.56637],"range":[-1.35,1.35],"fn":"sin(x)","p":0,"strokeColor":"#076D65","strokeWidth":4,"roughness":0}},
        {"at":"A wave","enter":"draw","duration":0.6,"add":{"id":"waveName","type":"text","x":232,"y":505,"text":"A sound wave","fontSize":31,"fontFamily":"normal","strokeColor":"#1D3539","textAlign":"center"}},
        {"at":"a budget","enter":"draw","duration":0.6,"add":{"id":"coverSliceA","type":"slice","share":50,"roughness":0,"strokeWidth":2,"backgroundColor":"#A8D4E6","strokeColor":"#225269","fontSize":27,"fontFamily":"normal","center":[634,384],"radius":91}},
        {"at":"a budget","enter":"draw","duration":0.6,"add":{"id":"coverSliceB","type":"slice","share":30,"roughness":0,"strokeWidth":2,"backgroundColor":"#F5CC86","strokeColor":"#714C1C","fontSize":27,"fontFamily":"normal","center":[634,384],"radius":91,"start":50}},
        {"at":"a budget","enter":"draw","duration":0.6,"add":{"id":"coverSliceC","type":"slice","share":20,"roughness":0,"strokeWidth":2,"backgroundColor":"#D0E6E0","strokeColor":"#275D53","fontSize":27,"fontFamily":"normal","center":[634,384],"radius":91,"start":80}},
        {"at":"a budget","enter":"draw","duration":0.6,"add":{"id":"pieName","type":"text","x":634,"y":505,"text":"A household budget","fontSize":31,"fontFamily":"normal","strokeColor":"#1D3539","textAlign":"center"}},
        {"at":"a library book","enter":"fade","duration":0.42,"add":{"id":"coverBook","type":"image","x":962,"y":288,"width":147,"height":193,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"76\" height=\"100\" viewBox=\"0 0 76 100\">\n  <path d=\"M8 3H69Q73 3 73 7V95Q73 98 68 98H9Q3 98 3 93V9Q3 4 8 3Z\" fill=\"#f4a23c\" stroke=\"#733d20\" stroke-width=\"3\"/>\n  <path d=\"M14 5V96M16 86H70\" fill=\"none\" stroke=\"#955128\" stroke-width=\"2\"/>\n  <path d=\"M5 88H70V94H8Q5 94 5 91Z\" fill=\"#fff3d3\"/>\n  <path d=\"M58 4H65V25L61 22L58 25Z\" fill=\"#ad4936\"/>\n  <circle cx=\"41\" cy=\"49\" r=\"16\" fill=\"#fff0c8\"/>\n  <path d=\"M27 54Q32 49 36 51Q42 51 44 42Q50 43 48 49Q52 49 55 47Q53 57 45 59H31\" fill=\"#875630\"/>\n</svg>"}},
        {"at":"a library book","enter":"fade","duration":0.42,"add":{"id":"bookName","type":"text","x":1035,"y":505,"text":"A library return","fontSize":31,"fontFamily":"normal","strokeColor":"#1D3539","textAlign":"center"}}
      ],
      "pause": 0.35
    },
    {
      "say": "Pull request sixteen published a film about five timed trials. One wave looked fine in preview, but two curves briefly appeared during playback. An earlier fix let one curve move smoothly as the waves canceled.",
