        {"at":"reveal","enter":"draw","duration":0.65,"add":{"id":"s22f","type":"slice","share":30,"roughness":0,"strokeWidth":2,"backgroundColor":"#F5CC86","strokeColor":"#714C1C","fontSize":27,"fontFamily":"normal","after":"s22h","label":"Food\n30%"}},
        {"at":"each slice","enter":"draw","duration":0.65,"add":{"id":"s22s","type":"slice","share":20,"roughness":0,"strokeWidth":2,"backgroundColor":"#D0E6E0","strokeColor":"#275D53","fontSize":24,"fontFamily":"normal","after":"s22f","label":"Savings\n20%"}}
