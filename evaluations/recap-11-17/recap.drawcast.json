        {"at":0,"duration":0,"remove":["coverKey","coverTitle","coverRule","coverWave","waveName","coverSliceA","coverSliceB","coverSliceC","pieName","coverBook","bookName"]},
        {"at":0,"enter":"none","duration":0,"add":{"id":"key1","type":"text","x":64,"y":40,"text":"PR #16   /   FIVE TIMED TRIALS","fontSize":24,"fontFamily":"code","strokeColor":"#076D65"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"head1","type":"text","x":62,"y":84,"text":"The wave that doubled in playback","fontSize":55,"fontFamily":"normal","strokeColor":"#1D3539"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"rule1","type":"line","points":[[64,169],[1214,169]],"strokeColor":"#B7C9C5","strokeWidth":2,"roughness":0}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"leftWaveTitle","type":"text","x":74,"y":218,"text":"Original playback","fontSize":34,"fontFamily":"normal","strokeColor":"#1D3539"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"rightWaveTitle","type":"text","x":682,"y":218,"text":"With the fix from PR #10","fontSize":34,"fontFamily":"normal","strokeColor":"#1D3539"}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"beforeAxis","type":"line","points":[[74,373],[580,373]],"strokeColor":"#B7C9C5","strokeWidth":2,"roughness":0}},
        {"at":0,"enter":"none","duration":0,"add":{"id":"afterAxis","type":"line","points":[[683,373],[1190,373]],"strokeColor":"#B7C9C5","strokeWidth":2,"roughness":0}},
        {"at":"One wave","enter":"draw","duration":0.7,"add":{"id":"badWave1","type":"line","x":78,"y":286,"width":500,"height":173,"domain":[0,12.56637],"range":[-1.35,1.35],"fn":"sin(x)","p":0,"strokeColor":"#92422D","strokeWidth":4,"roughness":0}},
        {"at":"two curves","enter":"draw","duration":0.6,"add":{"id":"badWave2","type":"line","x":78,"y":286,"width":500,"height":173,"domain":[0,12.56637],"range":[-1.35,1.35],"fn":"sin(x+0.54)","p":0,"strokeColor":"#DB9C83","strokeWidth":4,"roughness":0}},
        {"at":"An earlier fix","enter":"draw","duration":0.6,"add":{"id":"steadyWave","type":"line","x":683,"y":286,"width":500,"height":173,"domain":[0,12.56637],"range":[-1.35,1.35],"fn":"(sin(x)+sin(x+p))/2","p":0,"strokeColor":"#076D65","strokeWidth":4,"roughness":0}},
        {"at":"move smoothly","duration":1.9,"update":{"id":"steadyWave","p":3.141592653589793}},
        {"at":"waves canceled","enter":"fade","duration":0.3,"add":{"id":"beforeWaveNote","type":"text","x":75,"y":510,"text":"Two strokes during a crossfade","fontSize":27,"fontFamily":"normal","strokeColor":"#92422D"}},
        {"at":"waves canceled","enter":"fade","duration":0.3,"add":{"id":"afterWaveNote","type":"text","x":682,"y":510,"text":"The sum settles to zero","fontSize":27,"fontFamily":"normal","strokeColor":"#076D65"}}
      ],
      "pause": 0.35
    },
    {
