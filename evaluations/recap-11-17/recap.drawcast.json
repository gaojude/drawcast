        {"at":0,"enter":"none","duration":0,"add":{"id":"geom23","type":"text","x":630,"y":214,"text":"Housing sets the center and radius.","fontSize":30,"fontFamily":"normal","strokeColor":"#1D3539"}},
        {"at":"food starts","enter":"draw","duration":0.75,"add":{"id":"s23f","type":"slice","share":30,"roughness":0,"strokeWidth":2,"backgroundColor":"#F5CC86","strokeColor":"#714C1C","fontSize":27,"fontFamily":"normal","after":"s23h","label":"Food\n30%"}},
        {"at":"food starts","enter":"fade","duration":0.3,"add":{"id":"afterFood","type":"text","x":629,"y":316,"text":"after  \"housing\"","fontSize":33,"fontFamily":"code","strokeColor":"#076D65"}},
        {"at":"food starts","enter":"fade","duration":0.3,"add":{"id":"foodRow","type":"text","x":630,"y":365,"text":"Food takes the next 30%.","fontSize":26,"fontFamily":"normal","strokeColor":"#526B6C"}},
        {"at":"Savings follows","enter":"draw","duration":0.75,"add":{"id":"s23s","type":"slice","share":20,"roughness":0,"strokeWidth":2,"backgroundColor":"#D0E6E0","strokeColor":"#275D53","fontSize":24,"fontFamily":"normal","after":"s23f","label":"Savings\n20%"}},
